# ============================================
# PRODUCTION ENV TEMPLATE
# ============================================
# Copy this file to `.env` on the server, then replace all placeholder values.
# Never commit real production secrets to git.

# ============================================
# 1. PROJECT METADATA
# ============================================
PROJECT_NAME="Boilerplate"
PROJECT_VERSION=1.0.0
DEBUG=False
ENV=production

# ============================================
# 2. DATABASE CONFIGURATION
# ============================================
# Use the actual Postgres credentials that already exist in your production DB.
# IMPORTANT: If DB volume already exists, changing DB_USER/DB_PASSWORD here
# will not change existing Postgres credentials automatically.
DB_NAME=boilerplate_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_HOST=boilerplate_db

# Keep DATABASE_URL explicit in production (avoid variable interpolation ambiguity).
DATABASE_URL=postgresql://postgres:postgres@boilerplate_db:5432/boilerplate_db

# Redis (production hardening)
# Gunakan password kuat acak (minimal 32 karakter).
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@boilerplate_redis_prod:6379/0
REDIS_ENABLED=True
REDIS_FAIL_OPEN=False
CACHE_DEFAULT_TTL_SECONDS=300
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# ============================================
# 3. SECURITY & AUTHENTICATION
# ============================================
# Generate a long random key (at least 32 chars).
SECRET_KEY=dJQm7iofGM7awUq4UCruj8Yy5Yu3Q1viFagkKG0eBWR
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudflare Turnstile — setel kunci produksi dari dashboard Cloudflare (Widget → Site Key / Secret Key).
# Tanpa TURNSTILE_SECRET_KEY, backend tidak memaksa verifikasi. Tanpa VITE_TURNSTILE_SITE_KEY, widget tidak tampil.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ============================================
# 4. FRONTEND & GATEWAY CONFIGURATION
# ============================================
# If frontend and backend are behind same domain + nginx reverse proxy:
VITE_API_URL=/api/v1

# Replace with your real production domains.
# Example:
# BACKEND_CORS_ORIGINS=["https://app.yourdomain.com","https://yourdomain.com"]
BACKEND_CORS_ORIGINS=["http://localhost", "http://127.0.0.1"]

# ============================================
# 5. SERVER & LOGGING
# ============================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ============================================
# 6. FILE UPLOAD & STORAGE
# ============================================
# Bytes (5MB)
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=uploads

# ============================================
# 7. INITIAL ADMIN SEEDING
# ============================================
# Used when init/seeding runs. Set strong password and rotate after first login.
INIT_ADMIN_USERNAME=superadmin
INIT_ADMIN_EMAIL=superadmin@local.com
INIT_ADMIN_PASSWORD=12341234
INIT_ADMIN_FIRSTNAME=Super
INIT_ADMIN_LASTNAME=Admin

# ============================================
# 8. EMAIL CONFIGURATION (OPTIONAL)
# ============================================
# SMTP_TLS=True
# SMTP_PORT=587
# SMTP_HOST=smtp.yourdomain.com
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASSWORD=replace_with_smtp_password
# EMAILS_FROM_EMAIL=no-reply@yourdomain.com
# EMAILS_FROM_NAME="Boilerplate"
